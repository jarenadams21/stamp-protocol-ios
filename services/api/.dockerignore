# Only package files, src, db, and scripts are copied (see Dockerfile); this keeps secrets and local
# state out of the build context entirely.
.env
.env.*
!.env.example
.dev/
node_modules/
test/
*.log
.git
Dockerfile
.dockerignore
# Signing certificates and keys are never part of an image (they come from the secrets store).
*.pem
*.p12
*.cer
*.key
