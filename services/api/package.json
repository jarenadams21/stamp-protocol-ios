{
  "name": "joeyy-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "token": "node --env-file-if-exists=.env scripts/dev-token.ts",
    "images:cleanup": "node --env-file-if-exists=.env scripts/cleanup-images.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 'test/**/*.test.ts'",
    "auth:key": "node scripts/auth-key.ts",
    "seed:places": "node --env-file-if-exists=.env scripts/seed-sample-places.ts"
  },
  "dependencies": {
    "@azure/communication-email": "1.1.0",
    "@azure/communication-sms": "1.1.0",
    "@azure/identity": "4.14.1",
    "@azure/storage-blob": "12.34.0",
    "fastify": "5.12.8",
    "jose": "6.2.17",
    "pg": "8.23.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
