# Copy to .env (git-ignored). npm scripts load it automatically.

# Azure Database for PostgreSQL (dev). With no PGPASSWORD, the API signs in with a Microsoft
# Entra token from DefaultAzureCredential: your `az login` locally, a managed identity in Azure.
PGHOST=joeyy-dev-pg.postgres.database.azure.com
PGPORT=5432
PGDATABASE=joeyyRewards
PGUSER=<your Entra sign-in name, from: az account show --query user.name -o tsv>
# PGSSLMODE=disable        # only for a local or CI Postgres without TLS
# PGPASSWORD=              # set only to use password sign-in instead of Entra
# Locally, skip the managed-identity probe and use `az login` directly. Remove in Azure.
AZURE_TOKEN_CREDENTIALS=dev

# Migrations run as the role that owns the schema.
MIGRATION_ROLE=joeyyadmin

# Images. "azure" is a private Azure Blob Storage container, signed in to the same way as the
# database (no account key). "local" keeps files in .dev/images and serves them from this API, for
# working without Azure access.
IMAGE_STORE=azure
AZURE_STORAGE_ACCOUNT=<the storage account's name>
# AZURE_STORAGE_CONTAINER=images
# IMAGE_URL_TTL_SECONDS=900     # how long an image link works: 60 to 3600 seconds
# PUBLIC_BASE_URL=http://localhost:8080   # IMAGE_STORE=local only: where apps reach this API
# Hourly deletion of images nothing uses. On for azure and off for local unless set.
# IMAGE_CLEANUP=on
# IMAGE_UNUSED_HOURS=24         # how long an upload attached to nothing is kept

# Sign-in (docs/backend-spec.md section 8.5). The API issues its own tokens after Apple, Google, or
# a one-time code by email or text. There are no passwords. "dev" signs with a local key in .dev/
# (see `npm run token`) and writes codes to the log unless the Azure settings below are set. "live"
# needs the settings below; generate the two secrets with `npm run auth:key` and keep them in the
# secrets store.
AUTH_MODE=dev
# AUTH_ISSUER=https://api.joeyy.example         # live: this API's public URL, the tokens' issuer
# AUTH_SIGNING_KEY={"kty":"RSA",...}            # live: private RS256 JWK
# SIGN_IN_HASH_PEPPER=<at least 32 characters>  # live: key for hashing emails, phone numbers, and codes
# Which methods are on: apple, google, phone, email. Unset, live turns on each method whose
# settings below are present (dev turns on all). Live won't start with a method on but not set up.
# SIGN_IN_METHODS=google,email
# APPLE_AUDIENCES=com.joeyy.customer            # app bundle ID, plus the website's Services ID later
# Google: the "JOEYY iOS" client; add the website's web client ID after a comma later.
GOOGLE_CLIENT_IDS=461007702405-0fe1j629n2a79j3n0ss2mkoso67l9gqq.apps.googleusercontent.com
# Azure Communication Services, signed in like the database (no access key).
# Email codes: the dev Communication Services resource (joeyy-dev-acs) and its Azure managed domain.
# With both set, codes are really emailed, also in dev; remove them to log codes instead.
ACS_EMAIL_ENDPOINT=https://joeyy-dev-acs.unitedstates.communication.azure.com
EMAIL_FROM=DoNotReply@9aa68052-30df-47a1-98ee-71efb451688c.azurecomm.net
# ACS_ENDPOINT=https://<resource>.<region>.communication.azure.com         # text messages
# SMS_FROM=+1<the ACS toll-free number>
# PHONE_COUNTRY_CODES=1                         # countries that may get texts, without "+"
# TRUST_PROXY=true                              # behind a load balancer, so rate limits see client IPs

# The website (docs/web-connect.md). Its origins, comma-separated: only these get CORS with
# credentials, and only on /v1/web and /v1/places. Locally the Vite dev server proxies /v1 to this
# API, so the page and the API are one origin and nothing is needed here.
# WEB_ORIGINS=https://joeyy.app,https://www.joeyy.app
# Stand tap links. "dev" (the default outside production) also accepts picc=<tag uid>.<counter>, so
# the site works without hardware; "sun" verifies only real NTAG 424 DNA SUN messages and is the
# default, and the only choice, when NODE_ENV=production.
# TAG_MODE=dev
# The stands' AES-128 keys, 32 hex characters each, the same for every stand for now. Required with
# TAG_MODE=sun; with dev, set them to try real stands locally. Keep them in the secrets store.
# SUN_META_READ_KEY=<K_SDMMetaRead, decrypts the tag UID and counter>
# SUN_FILE_READ_KEY=<K_SDMFileRead, checks the MAC>

PORT=8080

# Native /api/v1 + /wallet/v1 are off by default. All settings below are
# required when enabled; no migrations or tag/customer seeding run at startup.
NATIVE_NFC_ENABLED=0
# Anonymous, isolated NFC test sessions only; requires native enabled, forbidden in production.
NATIVE_PROTOTYPE_MODE=0
# PUBLIC_BASE_URL=https://YOUR-STABLE-HTTPS-HOST
# SDM_BACKEND_URL=http://127.0.0.1:5005
# NATIVE_NFC_KEY_MODE=provisioned  # provisioned | factory-test
# FACTORY_KEY_TEST=1              # additionally REQUIRED for factory-test
# PASS_TYPE_ID=pass.com.yourcafe.loyalty
# TEAM_ID=YOURTEAMID
# SIGNER_CERT_PATH=/private/path/to/signerCert.pem
# SIGNER_KEY_PATH=/private/path/to/signerKey.pem
# WWDR_CERT_PATH=/private/path/to/wwdr.pem
# SIGNER_KEY_PASSPHRASE=
