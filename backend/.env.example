# Copy to .env (git-ignored). npm scripts load it automatically.

# Azure Database for PostgreSQL (dev). With no PGPASSWORD, the API signs in with a Microsoft
# Entra token from DefaultAzureCredential: your `az login` locally, a managed identity in Azure.
PGHOST=joeyy-dev-pg.postgres.database.azure.com
PGPORT=5432
PGDATABASE=joeyyRewards
PGUSER=<your Entra sign-in name, from: az account show --query user.name -o tsv>
# PGSSLMODE=disable        # only for a local or CI Postgres without TLS
# PGPASSWORD=              # set only to use password sign-in instead of Entra
# Locally, skip the managed-identity probe and use `az login` directly. Remove in Azure.
AZURE_TOKEN_CREDENTIALS=dev

# Migrations run as the role that owns the schema.
MIGRATION_ROLE=joeyyadmin

# Images. "azure" is a private Azure Blob Storage container, signed in to the same way as the
# database (no account key). "local" keeps files in .dev/images and serves them from this API, for
# working without Azure access.
IMAGE_STORE=azure
AZURE_STORAGE_ACCOUNT=<the storage account's name>
# AZURE_STORAGE_CONTAINER=images
# IMAGE_URL_TTL_SECONDS=900     # how long an image link works: 60 to 3600 seconds
# PUBLIC_BASE_URL=http://localhost:8080   # IMAGE_STORE=local only: where apps reach this API
# Hourly deletion of images nothing uses. On for azure and off for local unless set.
# IMAGE_CLEANUP=on
# IMAGE_UNUSED_HOURS=24         # how long an upload attached to nothing is kept

# Sign-in (docs/backend-spec.md section 8.5). The API issues its own tokens after Apple, Google, or a
# phone number and text code. "dev" signs with a local key in .dev/ (see `npm run token`) and writes
# phone codes to the log unless ACS_ENDPOINT is set. "live" needs the settings below; generate the
# two secrets with `npm run auth:key` and keep them in the secrets store.
AUTH_MODE=dev
# AUTH_ISSUER=https://api.joeyy.example         # live: this API's public URL, the tokens' issuer
# AUTH_SIGNING_KEY={"kty":"RSA",...}            # live: private RS256 JWK
# PHONE_HASH_PEPPER=<at least 32 characters>    # live: key for hashing phone numbers and codes
# APPLE_AUDIENCES=com.joeyy.customer            # app bundle ID, plus the website's Services ID later
# GOOGLE_CLIENT_IDS=<iOS client ID>,<web client ID>   # Google sign-in is off until this is set
# PHONE_COUNTRY_CODES=1                         # countries that may get texts, without "+"
# Azure Communication Services, signed in like the database (no access key).
# ACS_ENDPOINT=https://<resource>.communication.azure.com
# SMS_FROM=+1<the ACS toll-free number>
# TRUST_PROXY=true                              # behind a load balancer, so rate limits see client IPs

PORT=8080
