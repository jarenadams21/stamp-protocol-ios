// Optional, ignored machine-specific service URL and signing team.
LOYALTY_API_BASE_URL = https:/$()/example.invalid
LOYALTY_PROTOTYPE_MODE = NO
// The domain the NFC chips point at. Tapping a chip opens this app when the domain vouches for it (the
// apple-app-site-association file on that domain; see docs/setup/tap-opens-app.md). The chips store this
// address, so change it only together with reprogramming them.
LOYALTY_TAP_LINK_HOST = try.thejoeyy.site
#include? "Local.xcconfig"
